# Examples only. Do not put a real token or password in git.
# Create the secrets in your own Rahti project:
#   oc create secret generic exercise-2-aitta --from-literal=AITTA_API_KEY='<token from class>'
#   oc create secret generic exercise-2-access --from-literal=COURSE_PASSWORD='<password from class>'
apiVersion: v1
kind: Secret
metadata:
  name: exercise-2-aitta
type: Opaque
stringData:
  AITTA_API_KEY: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: exercise-2-access
type: Opaque
stringData:
  COURSE_PASSWORD: ""
