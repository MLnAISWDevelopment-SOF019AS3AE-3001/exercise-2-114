# Copy to .env.local for a local run. Do not commit .env.local.
BACKEND_URL=http://localhost:8000

# API process. The token is the one given in class. It is never committed.
LLM_PROVIDER=aitta
DEMO_LLM_MODEL=google/gemma-4-31b-it
AITTA_EMBEDDING_MODEL=lightonai/modernbert-embed-large
AITTA_BASE_URL=https://aitta-api.csc.fi/openai/v1
AITTA_API_KEY=your-csc-aitta-token
COURSE_PASSWORD=your-course-password
